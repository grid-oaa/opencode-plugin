{
  "manifest_version": 3,
  "name": "OpenCode 提问导航",
  "version": "0.4.0",
  "description": "在 opencode pair 网页右侧显示提问导航，快速定位历史消息，提供全局会话书签、多个网页版 AI 对话侧栏和提示词优化。",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开智谱清言侧栏"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": [
        "ai-sites.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
